<?xml version="1.0" encoding="utf-8"?>
<!--Tarjeta de producto-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tarjeta_producto_cliente"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:minHeight="112dp"
    android:theme="@style/TemaClienteAmbulantitos"
    app:cardBackgroundColor="#EEE7F7"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    tools:theme="@style/TemaClienteAmbulantitos">
    <!--Contenido de la tarjeta-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="112dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">
        <!--Icono del producto-->
        <ImageView
            android:id="@+id/imagen_producto_cliente"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@null" />
        <!--Datos del producto-->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <!--Nombre del producto-->
            <TextView
                android:id="@+id/nombre_producto_cliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="24dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:textStyle="bold" />
            <!--Precio del producto-->
            <TextView
                android:id="@+id/precio_producto_cliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="24dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
        <ImageView
            android:id="@+id/flecha_producto_cliente"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/icono_ver_producto_cliente"
            android:contentDescription="@null" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>