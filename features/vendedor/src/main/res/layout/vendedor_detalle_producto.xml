<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/vendedor_detalle_producto_btn_volver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/vendedor_formulario_producto_volver"
            android:scaleType="center"
            android:src="@drawable/vendedor_registro_ic_volver" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:accessibilityHeading="true"
            android:text="@string/vendedor_detalle_producto_titulo"
            android:textColor="#231F26"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8DFE7" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/vendedor_detalle_producto_icono"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/vendedor_producto_fondo_icono"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                tools:src="@drawable/vendedor_producto_ic_esquite" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/vendedor_detalle_producto_nombre"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:accessibilityHeading="true"
                    android:textColor="#231F26"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Esquite" />

                <TextView
                    android:id="@+id/vendedor_detalle_producto_precio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#9E2412"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="$30.00" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/vendedor_panel_fondo_pedido"
                android:padding="12dp">

                <!-- Grises para la etiqueta y el valor de Unidad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/vendedor_detalle_producto_etiqueta_unidad"
                        android:textColor="#706674"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/vendedor_detalle_producto_unidad"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="#231F26"
                        android:textSize="14sp"
                        tools:text="pieza" />

                </LinearLayout>

                <!-- Grises para la etiqueta y el valor de Existencias -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/vendedor_detalle_producto_etiqueta_existencias"
                        android:textColor="#706674"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/vendedor_detalle_producto_existencias"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="#231F26"
                        android:textSize="14sp"
                        tools:text="12" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/vendedor_detalle_producto_etiqueta_estado"
                        android:textColor="#706674"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/vendedor_detalle_producto_estado"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="#9E2412"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="En existencia" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/vendedor_detalle_producto_etiqueta_marca"
                        android:textColor="#706674"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/vendedor_detalle_producto_marca"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="#231F26"
                        android:textSize="14sp"
                        tools:text="Sin marca" />

                </LinearLayout>

            </LinearLayout>

            <!-- Gris oscuro para el encabezado de Descripción -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:text="@string/vendedor_formulario_producto_descripcion"
                android:textColor="#231F26"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Gris para la descripción del producto -->
            <TextView
                android:id="@+id/vendedor_detalle_producto_descripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#5B505F"
                android:textSize="14sp"
                tools:text="Esquite con queso y mayonesa" />

            <!-- Gris oscuro para el encabezado de Ingredientes -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:text="@string/vendedor_formulario_producto_ingredientes"
                android:textColor="#231F26"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vendedor_detalle_producto_ingredientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#5B505F"
                android:textSize="14sp"
                tools:text="Maíz · Mayonesa · Queso" />

            <TextView
                android:id="@+id/vendedor_detalle_producto_actualizacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#706674"
                android:textSize="12sp"
                tools:text="Actualizado: 24/11/2026 · 10:30" />

            <Button
                android:id="@+id/vendedor_detalle_producto_btn_editar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="48dp"
                android:background="@drawable/vendedor_login_fondo_boton"
                android:backgroundTint="@null"
                android:text="@string/vendedor_detalle_producto_editar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <Button
                android:id="@+id/vendedor_detalle_producto_btn_marcar_agotado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:background="@drawable/vendedor_panel_fondo_boton_secundario"
                android:backgroundTint="@null"
                android:text="@string/vendedor_detalle_producto_marcar_agotado"
                android:textAllCaps="false"
                android:textColor="#9E2412"
                android:textSize="14sp" />

            <Button
                android:id="@+id/vendedor_detalle_producto_btn_eliminar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:background="@drawable/vendedor_panel_fondo_boton_secundario"
                android:backgroundTint="@null"
                android:text="@string/vendedor_detalle_producto_eliminar"
                android:textAllCaps="false"
                android:textColor="#9E2412"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>