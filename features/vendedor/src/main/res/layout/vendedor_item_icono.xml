<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/vendedor_item_icono_opcion"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:minHeight="128dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/vendedor_icono_fondo_opcion"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="16dp">

    <ImageView
        android:id="@+id/vendedor_item_icono_imagen"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        tools:src="@drawable/vendedor_producto_ic_esquite" />

    <TextView
        android:id="@+id/vendedor_item_icono_nombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#231F26"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Esquite" />

</LinearLayout>