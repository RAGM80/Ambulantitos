<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/vendedor_panel_fondo_pedido"
    android:padding="12dp">
    <ImageView
        android:id="@+id/vendedor_detalle_producto_icono"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginEnd="12dp"
        android:background="@drawable/vendedor_producto_fondo_icono"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        tools:src="@android:drawable/ic_menu_gallery" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
    <TextView
        android:id="@+id/vendedor_item_producto_nombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#231F26"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Esquite" />

        <TextView
            android:id="@+id/vendedor_item_producto_precio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#9E2412"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="$30.00" />

        <TextView
            android:id="@+id/vendedor_item_producto_existencias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#706674"
            android:textSize="12sp"
            tools:text="12 piezas disponibles" />

        <TextView
            android:id="@+id/vendedor_item_producto_estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/vendedor_producto_fondo_disponible"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="#385B32"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="En existencia" />

    </LinearLayout>
</LinearLayout>
