<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF9FC">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="80dp"
    android:paddingBottom="32dp">

<ImageView
    android:layout_width="224dp"
    android:layout_height="96dp"
    android:src="@drawable/vendedor_logo_ambulantitos"
    android:scaleType="fitCenter"
    android:contentDescription="@null"/>

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:text="@string/vendedor_login_titulo"
    android:textColor="#9E2412"
    android:textSize="26sp"
    android:textStyle="bold" />

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="32dp">


<EditText
    android:id="@+id/vendedor_login_usuario"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="7dp"
    android:minHeight="48dp"
    android:background="@drawable/vendedor_login_fondo_campo"
    android:paddingStart="12dp"
    android:inputType="text"
    android:singleLine="true"
    android:autofillHints="username"/>

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:background="#FFF9FC"
    android:paddingStart="4dp"
    android:includeFontPadding="false"
    android:labelFor="@id/vendedor_login_usuario"
    android:text="@string/vendedor_login_usuario"
    android:textSize="12sp"/>
</FrameLayout>

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp">

<EditText
    android:id="@+id/vendedor_login_contraseña"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="7dp"
    android:minHeight="48dp"
    android:background="@drawable/vendedor_login_fondo_campo"
    android:paddingStart="12dp"
    android:paddingEnd="48dp"
    android:inputType="textPassword"
    android:singleLine="true"
    android:autofillHints="password"/>

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:background="#FFF9FC"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:includeFontPadding="false"
    android:labelFor="@id/vendedor_login_contraseña"
    android:text="@string/vendedor_login_contraseña"
    android:textSize="12sp"/>

<ImageButton
    android:id="@+id/vendedor_login_btn_ojo"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:layout_gravity="top|end"
    android:layout_marginTop="7dp"
    android:background="?android:attr/selectableItemBackgroundBorderless"
    android:contentDescription="@string/vendedor_login_mostrar_contraseña"
    android:scaleType="center"
    android:src="@drawable/vendedor_login_ic_ojo"/>
</FrameLayout>
    <Button
        android:id="@+id/vendedor_login_btn_ingreso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:minHeight="48dp"
        android:background="@drawable/vendedor_login_fondo_boton"
        android:backgroundTint="@null"
        android:text="@string/vendedor_login_titulo"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp"/>
<Button
    android:id="@+id/vendedor_login_btn_crear_cuenta"
    style="?android:attr/borderlessButtonStyle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:minHeight="48dp"
    android:text="@string/vendedor_login_crear_cuenta"
    android:textAllCaps="false"
    android:textColor="#9E2412"
    android:textSize="14sp"/>

<Button
    android:id="@+id/vendedor_login_btn_olvide_contraseña"
    style="?android:attr/borderlessButtonStyle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:text="@string/vendedor_login_olvide_contraseña"
    android:textAllCaps="false"
    android:textColor="#9E2412"
    android:textSize="14sp"/>
</LinearLayout>

</ScrollView>