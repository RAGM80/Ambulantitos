<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9FC">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="16dp">
   <ImageButton
       android:id="@+id/vendedor_registro_boton_volver"
       android:layout_width="48dp"
       android:layout_height="48dp"
       android:background="?android:attr/selectableItemBackgroundBorderless"
       android:contentDescription="@string/vendedor_registro_volver"
       android:scaleType="center"
       android:src="@drawable/vendedor_registro_ic_volver"/>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:accessibilityHeading="true"
        android:text="@string/vendedor_registro_titulo"
        android:textColor="#231F26"
        android:textSize="20sp"
        android:textStyle="bold"/>
</LinearLayout>
<View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:background="#E8DFE7"/>



<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/vendedor_registro_nombres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:autofillHints="personGivenName"
                android:background="@drawable/vendedor_login_fondo_campo"
                android:inputType="textPersonName|textCapWords"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="#FFF9FC"
                android:includeFontPadding="false"
                android:labelFor="@id/vendedor_registro_nombres"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/vendedor_registro_nombres"
                android:textSize="12sp"/>

        </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <EditText
            android:id="@+id/vendedor_registro_apellido_paterno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:minHeight="48dp"
            android:background="@drawable/vendedor_login_fondo_campo"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="textPersonName|textCapWords"
            android:singleLine="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="#FFF9FC"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:includeFontPadding="false"
            android:labelFor="@id/vendedor_registro_apellido_paterno"
            android:text="@string/vendedor_registro_apellido_paterno"
            android:textSize="12sp"/>

    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <EditText
            android:id="@+id/vendedor_registro_apellido_materno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:minHeight="48dp"
            android:background="@drawable/vendedor_login_fondo_campo"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="textPersonName|textCapWords"
            android:singleLine="true"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="#FFF9FC"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:includeFontPadding="false"
            android:labelFor="@id/vendedor_registro_apellido_materno"
            android:text="@string/vendedor_registro_apellido_materno"
            android:textSize="12sp"/>
    </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <EditText
                android:id="@+id/vendedor_registro_fecha_nacimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:minHeight="48dp"
                android:background="@drawable/vendedor_login_fondo_campo"
                android:paddingStart="12dp"
                android:paddingEnd="48dp"
                android:inputType="date"
                android:singleLine="true" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="#FFF9FC"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:includeFontPadding="false"
                android:labelFor="@id/vendedor_registro_fecha_nacimiento"
                android:text="@string/vendedor_registro_fecha_nacimiento"
                android:textSize="12sp" />
            <ImageButton
                android:id="@+id/vendedor_registro_btn_calendario"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="7dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/vendedor_registro_seleccionar_fecha"
                android:scaleType="center"
                android:src="@drawable/vendedor_registro_ic_calendario"/>

        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <EditText
                android:id="@+id/vendedor_registro_nombre_negocio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:minHeight="48dp"
                android:background="@drawable/vendedor_login_fondo_campo"
                android:paddingStart="12dp"
                android:inputType="textCapWords"
                android:singleLine="true"/>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="#FFF9FC"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:includeFontPadding="false"
            android:labelFor="@id/vendedor_registro_nombre_negocio"
            android:text="@string/vendedor_registro_nombre_negocio"
            android:textSize="12sp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <EditText
                android:id="@+id/vendedor_registro_usuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:minHeight="48dp"
                android:background="@drawable/vendedor_login_fondo_campo"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="textVisiblePassword"
                android:singleLine="true"
                android:autofillHints="newUsername" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="#FFF9FC"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:includeFontPadding="false"
                android:labelFor="@id/vendedor_registro_usuario"
                android:text="@string/vendedor_registro_usuario"
                android:textSize="12sp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <EditText
                android:id="@+id/vendedor_registro_contraseña"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:minHeight="48dp"
                android:background="@drawable/vendedor_login_fondo_campo"
                android:paddingStart="12dp"
                android:paddingEnd="48dp"
                android:inputType="textPassword"
                android:singleLine="true"
                android:autofillHints="newPassword" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="#FFF9FC"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:includeFontPadding="false"
            android:labelFor="@id/vendedor_registro_contraseña"
            android:text="@string/vendedor_registro_contraseña"
            android:textSize="12sp" />
            
            <ImageButton
                android:id="@+id/vendedor_registro_btn_ojo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="7dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/vendedor_registro_mostrar_contraseña"
                android:scaleType="center"
                android:src="@drawable/vendedor_login_ic_ojo" />
        </FrameLayout>
        <Button
            android:id="@+id/vendedor_registro_btn_crear_cuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:minHeight="48dp"
            android:background="@drawable/vendedor_login_fondo_boton"
            android:backgroundTint="@null"
            android:text="@string/vendedor_registro_crear_cuenta"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"/>
    </LinearLayout>

</ScrollView>
</LinearLayout>