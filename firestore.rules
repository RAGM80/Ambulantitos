rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function esDueno(userId) {
      return autenticado() && uid() == userId;
    }

    function esVendedorDelNegocio(vendorId) {
      return autenticado()
        && get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerUserId == uid();
    }

    function sinContrasena(datos) {
      return !datos.keys().hasAny(['password', 'contrasena', 'contraseña']);
    }

    function formaPagoValida(datos) {
      return datos.formaPago == 'Pago en efectivo al entregar';
    }

    match /users/{userId} {
      // El perfil contiene datos personales; cada usuario solo puede consultar el suyo.
      allow read: if esDueno(userId);
      allow create: if esDueno(userId)
        && sinContrasena(request.resource.data)
        && request.resource.data.userId == userId
        && request.resource.data.role in ['client', 'vendor'];
      allow update: if esDueno(userId)
        && sinContrasena(request.resource.data)
        && request.resource.data.userId == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /usernames/{usuario} {
      // El registro consulta directamente el nombre elegido dentro de una transacción.
      // Se permite get para detectar colisiones, pero nunca listar el directorio completo.
      allow get: if autenticado();
      allow list: if false;
      allow create: if autenticado()
        && request.resource.data.userId == uid();
      allow update, delete: if false;
    }

    match /vendors/{vendorId} {
      allow read: if autenticado();
      allow create: if autenticado()
        && request.resource.data.ownerUserId == uid()
        && request.resource.data.vendorId == vendorId
        && request.resource.data.formaPagoPorDefecto == 'Pago en efectivo al entregar';
      allow update: if esVendedorDelNegocio(vendorId)
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.formaPagoPorDefecto == 'Pago en efectivo al entregar';
      allow delete: if false;

      match /products/{productId} {
        allow read: if autenticado();
        allow create, update: if esVendedorDelNegocio(vendorId)
          && request.resource.data.productId == productId
          && request.resource.data.iconoClave in ['elote', 'esquite', 'taco', 'helado', 'bebida', 'otro']
          && request.resource.data.estado in ['En existencia', 'Agotado'];
        allow delete: if false;
      }
    }

    match /orders/{orderId} {
      allow read: if autenticado()
        && (resource.data.clientId == uid() || esVendedorDelNegocio(resource.data.vendorId));

      allow create: if autenticado()
        && request.resource.data.clientId == uid()
        && request.resource.data.orderId == orderId
        && formaPagoValida(request.resource.data)
        && request.resource.data.estado == 'Pendiente'
        && request.resource.data.estadoEnvio in ['confirmado', 'sin_confirmar'];

      allow update: if autenticado()
        && formaPagoValida(request.resource.data)
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.vendorId == resource.data.vendorId
        && (
          (
            resource.data.clientId == uid()
            && request.resource.data.estado == resource.data.estado
            && request.resource.data.estadoEnvio in ['confirmado', 'sin_confirmar']
          )
          || (
            esVendedorDelNegocio(resource.data.vendorId)
            && request.resource.data.estado in ['Pendiente', 'Aceptado', 'Rechazado', 'Entregado']
          )
        );

      allow delete: if false;
    }
  }
}
